# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
#
# Supabase Project URL and anon/public key (Settings -> API in the Supabase dashboard).
# The anon key is safe to expose in client code: access is controlled by Row Level
# Security policies, not by keeping this key secret. NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Personal-use app: no login screen. The app silently signs in to this one existing
# Supabase account. Bundled into the client build, so only run/host this privately
# (localhost or an access-protected host) — never deploy it to a public URL.
VITE_PERSONAL_EMAIL=
VITE_PERSONAL_PASSWORD=
